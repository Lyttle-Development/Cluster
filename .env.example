# Cluster Node Environment Configuration Template
# Copy to .env or /etc/cluster-node.env for unattended automated execution

# Node Role: "server" or "agent"
ROLE="server"

# DigitalOcean Managed PostgreSQL 18 connection string (Required for server role)
DATASTORE_ENDPOINT="postgres://k3s_user:your_password@db-postgresql-nyc1-do-user-123.b.db.ondigitalocean.com:25060/k3s_cluster?sslmode=require"

# K3s Cluster Secret Token (Auto-generated if left empty for server; required for agent)
K3S_TOKEN=""

# K3s Server URL (Required for agent role, e.g. https://1.2.3.4:6443)
K3S_SERVER_URL=""

# Cloudflare Tunnel Token (Optional; automatically deploys cloudflared on server)
CLOUDFLARE_TUNNEL_TOKEN=""

# SSH Port to allow in UFW (Default: 22)
SSH_PORT="22"
